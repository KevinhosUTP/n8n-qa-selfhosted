{
  "name": "@kevolint/web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=22.20.0 <23",
    "npm": ">=10.9.3 <11"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "prebuild": "node scripts/check-design-build.mjs",
    "build": "next build",
    "start": "node scripts/start-standalone.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "design:generate": "node scripts/generate-design-tokens.mjs",
    "design:check": "node scripts/generate-design-tokens.mjs --check",
    "design:preview": "node scripts/design-preview.mjs",
    "design:browser": "node scripts/check-design-browser.mjs",
    "design:verify": "node scripts/verify-design-browser.mjs",
    "public:verify": "node scripts/verify-public-navigation.mjs",
    "test:boundary": "node scripts/check-client-boundary.mjs",
    "smoke": "node scripts/smoke-http.mjs",
    "security:dependencies": "node scripts/security-control.mjs dependencies",
    "security:exposure": "node scripts/security-control.mjs exposure",
    "security:artifact": "node scripts/security-control.mjs artifact"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.2",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
